* Local IBM MQ objects aligned with mq-config (non-TLS dev profile)

DEFINE QLOCAL('PWM.VE.RESPONSE.QUEUE') REPLACE +
  DESCR('VE response queue - local dev') +
  PUT(ENABLED) GET(ENABLED)

DEFINE CHANNEL('DBTAX.VE.SVRCONN') CHLTYPE(SVRCONN) TRPTYPE(TCP) +
  DESCR('Local dev SVRCONN channel')

* Allow client connections on custom channel (dev)
SET CHLAUTH('DBTAX.VE.SVRCONN') TYPE(ADDRESSMAP) ADDRESS('*') USERSRC(CHANNEL) ACTION(REPLACE)

* Queue and channel authority for app user and mqclient group
SET AUTHREC OBJTYPE(QUEUE) PROFILE(PWM.VE.RESPONSE.QUEUE) PRINCIPAL('app') AUTHADD(GET,PUT,BROWSE,INQ)
SET AUTHREC OBJTYPE(QUEUE) PROFILE(PWM.VE.RESPONSE.QUEUE) GROUP('mqclient') AUTHADD(GET,PUT,BROWSE,INQ)
SET AUTHREC OBJTYPE(CHANNEL) PROFILE(DBTAX.VE.SVRCONN) PRINCIPAL('app') AUTHADD(CONNECT)
SET AUTHREC OBJTYPE(CHANNEL) PROFILE(DBTAX.VE.SVRCONN) GROUP('mqclient') AUTHADD(CONNECT)
